# 与 docker-compose.yml 同级放置，全部可选。

## ---- 运行期：容器访问 TMDB / Telegram 走的代理 ----
# 留空即用后台「设置」页写回 data/config.yaml 的值；一旦在此填写，容器内以这里的为准。
TMDB_API_KEY=
TG_BOT_TOKEN=
GUANGYA_COOKIE=
# 代理跑在宿主机时写 host.docker.internal:7890（这里支持 socks5）
PROXY_ADDR=
# 仅首次启动（用户表为空）时生效
ADMIN_USERNAME=
ADMIN_PASSWORD=

## ---- 构建期：docker compose build 拉依赖走的代理与镜像源 ----
# 构建沙箱里的 127.0.0.1 不是宿主机，写宿主机局域网 IP（如 http://192.168.1.10:7890），
# 或在 compose 里放开 build.network: host 后写 http://127.0.0.1:7890。要 HTTP 端口，不能给 socks5。
BUILD_PROXY=
NPM_REGISTRY=https://registry.npmjs.org
GOPROXY=https://proxy.golang.org,direct
GOSUMDB=sum.golang.org

# 网络差的一套推荐组合：
#   BUILD_PROXY=http://192.168.1.10:7890
#   NPM_REGISTRY=https://registry.npmmirror.com
#   GOPROXY=https://goproxy.cn,direct
# 完全走不了外网时别在服务器上构建：在能出网的机器（或 CI）上 docker build，
# 再 docker save 成 tar 拷过来 docker load，详见 README「离线投递」。
